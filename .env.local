# prodai-atlas — local 모드 (docker compose · 서비스별 SQLite). 시크릿 없음 → 커밋 가능 / no secrets, committable
# 서비스 고유 설정은 apps/manager/.env.local · agents/runtime/.env.local 에서 읽는다.
ATLAS_VERSION=0.2.0
# Manager 리슨 주소 (데스크톱 사이드카는 127.0.0.1:<임의 포트>)
ATLAS_LISTEN=:8080
APP_ENV=local
BIND_HOST=127.0.0.1
MANAGER_PORT=8080
AL_PLAN_PORT=8000
AL_RUN_PORT=8001
MCP_REG_PORT=8002
MCP_DEMO_PORT=8003
MCP_TOOL_PORT=8004
ATLAS_MCP_REG_ADMIN_TOKEN=local-mcp-admin
GR_PORT=8005
ATLAS_GUARD_ADMIN_TOKEN=local-guard-admin
ATLAS_GUARD_SECRET=local-dev-guard-secret
ATLAS_GUARD_ON_ERROR=fail_open
# Gateway 배치 폴링 첫 간격(초) — local 은 시험용 1초
ATLAS_BATCH_POLL_BASE_SEC=1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=atlas
CLICKHOUSE_PASSWORD=local-clickhouse-dev
OB_PORT=8006
ATLAS_OB_CAPTURE=redacted
ATLAS_OB_ECHO_RECEIVER=true
ATLAS_OB_ALERT_INTERVAL=30
EV_PORT=8007
ATLAS_EV_CURATOR_TOKEN=local-ev-curator
GATEWAY_PORT=8090
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
ATLAS_PROBE_INTERVAL=5s
# AI Gateway — local 은 mock 공급자 전용 개발 값(실 자격증명 아님). prod 는 .env.prod 에서 Secret 주입.
ATLAS_GATEWAY_ADMIN_TOKEN=local-admin-token
ATLAS_GATEWAY_AL_PLAN_KEY=sk-atlas-local-devAlPlanKey0000000000
OPENAI_BASE_URL=
OPENAI_API_KEYS=
CONSOLE_PORT=5173
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# ---- 인증·인가·테넌시 (PLT-IAM · PLT-TEN, M2) ----
# Manager 인증 모드: off = 로컬 개발(모두 관리자, 인증 없음) · oidc = Keycloak 토큰 또는 API 키 필수
ATLAS_AUTH_MODE=off
KEYCLOAK_PORT=8180
# 브라우저가 여는 Keycloak 주소 = 토큰 issuer (원격 설치는 공개 주소로)
ATLAS_KEYCLOAK_URL=http://127.0.0.1:8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-kc-admin
# realm atlas 의 서비스 계정 클라이언트(atlas-ci) 비밀 — client credentials (FR-PLT-IAM-06)
ATLAS_KC_CI_SECRET=local-kc-ci-secret
OPENFGA_PRESHARED_KEY=local-fga-key
# A2A 테넌트 JWT 서명 키 (EC P-256 PEM 또는 base64(PEM)). 비우면 임시 키(단일 인스턴스만)
ATLAS_A2A_SIGNING_KEY=
# 에이전트 자가 등록·MCP 도구용 서비스 API 키 (atl_{env}_{26자}_{secret})
ATLAS_MANAGER_BOOTSTRAP_KEY=atl_local_devbootstrap00000000000000_localdevonlysecret
# 에이전트 A2A 테넌트 토큰 검사: off · verify(있으면 검증) · required
ATLAS_A2A_AUTH=verify

# ---- 비밀 (PLT-SEC, M2) ----
# Manager 비밀 저장소: file:///경로 (로컬) · bao://호스트:포트/마운트?token_file=… (OpenBao KV v2)
ATLAS_SECRET_STORE=file:///app/data/secrets
# Gateway 공급자 키 저장소 (비우면 OPENAI_API_KEYS env — 키 회전 API 비활성)
ATLAS_GATEWAY_SECRET_STORE=
# 에이전트 환경변수 비밀 허용 (기본 false — Manager 비밀 중개만)
ATLAS_ALLOW_ENV_SECRETS=false

# ---- A2A (M2 2차) ----
# push webhook 으로 허용할 내부 호스트(쉼표). 비우면 https·공인 주소만 (SSRF 차단, FR-A2A-SRV-03)
ATLAS_PUSH_ALLOW_HOSTS=host.docker.internal
# 분석 샌드박스 공유 토큰 (ma-anl 은 Manager 비밀 중개 sandbox-token 으로 받는다)
ATLAS_SANDBOX_TOKEN=local-dev-sandbox-token

# 알림 (X-NTF) — Manager 가 이벤트 규칙에 따라 webhook·email 발송. 로컬은 Mailpit(UI :8025) 이 메일을 받는다
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
ATLAS_SMTP_ADDR=mailpit:1025
ATLAS_SMTP_FROM=atlas@localhost
# 사설 주소 webhook 허용 호스트(쉼표) — 그 외는 https + 공인 주소만 (SSRF 차단)
ATLAS_NOTIFY_ALLOW_HOSTS=host.docker.internal

# 지식베이스 URL 원천 커넥터가 접근할 사설 주소 허용 호스트(쉼표) — 그 외는 https + 공인 주소만 (SSRF 차단, X-KB-01)
ATLAS_KB_URL_ALLOW_HOSTS=fake-upstream

# egress 프록시 관리 토큰 — 샌드박스·MCP 커넥터 송신 허용목록 정책 등록 (Manager 가 egress-admin-token 비밀로 1회 이관, X-SBX-02 · MCP-SYS-04)
ATLAS_EGRESS_ADMIN_TOKEN=local-egress-admin

# X-MKT 관리 토큰 — 공개키 등록·폐기·MCP 카탈로그 동기화/가져오기 (Manager 가 mkt-admin-token 비밀로 1회 이관)
ATLAS_MKT_ADMIN_TOKEN=local-mkt-admin
# X-RPT 관리 토큰 — 요율표·SIEM 싱크·월 마감·보고서 발송 (rpt-admin-token)
ATLAS_RPT_ADMIN_TOKEN=local-rpt-admin
# X-RPT 수집 HMAC — X-NTF webhook(plt.*·gw.*) → /v1/ingest/events 서명 검증 (rpt-ingest-secret)
ATLAS_RPT_INGEST_SECRET=local-rpt-ingest

# MCP 게이트웨이 인바운드 인증 — optional(개발: 토큰 없으면 anonymous) · required(aud=atlas-mcp-gateway JWT 필수, FR-MCP-HOST-07)
ATLAS_MCP_GW_AUTH=optional
