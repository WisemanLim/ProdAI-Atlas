{
  "apiVersion": "agents.prodai.io/v1alpha1",
  "kind": "AtlasAgent",
  "metadata": {"name": "ma-res", "unitId": "MA-RES", "layer": "L1", "concept": "03-multi-agent"},
  "spec": {
    "version": "0.1.0",
    "interfaces": [{"binding": "JSONRPC", "port": 8000, "path": "/a2a"}],
    "agentCard": {"path": "/.well-known/agent-card.json", "visibility": "tenant", "skills": ["ma.research"]},
    "harness": {"modelAlias": "chat-default", "tools": ["corpus.search"], "guardrailPolicyRef": null},
    "config": {"topK": 5, "summaryMaxTokens": 2000},
    "health": {"liveness": "/healthz", "readiness": "/readyz", "startupTimeoutSec": 60},
    "drivers": {"supported": ["local", "compose"]}
  }
}
