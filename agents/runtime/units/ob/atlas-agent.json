{
  "apiVersion": "agents.prodai.io/v1alpha1",
  "kind": "AtlasAgent",
  "metadata": {
    "name": "ob-trace",
    "unitId": "OB-TRACE",
    "layer": "L3",
    "concept": "08-observability"
  },
  "spec": {
    "version": "0.1.0",
    "interfaces": [
      {
        "binding": "JSONRPC",
        "port": 8000,
        "path": "/a2a"
      }
    ],
    "agentCard": {
      "path": "/.well-known/agent-card.json",
      "signed": false,
      "skills": [
        "ob.trace"
      ]
    },
    "health": {
      "liveness": "/healthz",
      "readiness": "/readyz",
      "startupTimeoutSec": 60
    },
    "state": {
      "stateless": false,
      "store": "sql+clickhouse",
      "stateSchemaVersion": 1
    },
    "drivers": {
      "supported": [
        "local",
        "compose"
      ]
    },
    "compat": {
      "agentCore": ">=0.1 <1.0",
      "a2a": "1.0"
    }
  }
}
