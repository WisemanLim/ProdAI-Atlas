{
  "apiVersion": "agents.prodai.io/v1alpha1",
  "kind": "AtlasAgent",
  "metadata": {"name": "ma-anl", "unitId": "MA-ANL", "layer": "L1", "concept": "03-multi-agent"},
  "spec": {
    "version": "0.1.0",
    "interfaces": [{"binding": "JSONRPC", "port": 8000, "path": "/a2a"}],
    "agentCard": {"path": "/.well-known/agent-card.json", "visibility": "tenant", "skills": ["ma.analysis"]},
    "harness": {"modelAlias": "chat-default", "tools": ["sandbox.run"], "guardrailPolicyRef": null},
    "config": {"timeoutS": 300, "memMb": 1024, "maxRows": 50},
    "secrets": [{"name": "sandbox-token", "required": true}],
    "health": {"liveness": "/healthz", "readiness": "/readyz", "startupTimeoutSec": 60},
    "drivers": {"supported": ["local", "compose"]}
  }
}
