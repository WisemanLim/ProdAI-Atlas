{
  "apiVersion": "agents.prodai.io/v1alpha1",
  "kind": "AtlasAgent",
  "metadata": {
    "name": "gr-io",
    "unitId": "GR-IO",
    "layer": "L2",
    "concept": "07-guardrails"
  },
  "spec": {
    "version": "0.1.0",
    "interfaces": [
      {
        "binding": "JSONRPC",
        "port": 8000,
        "path": "/a2a"
      }
    ],
    "agentCard": {
      "path": "/.well-known/agent-card.json",
      "signed": false,
      "skills": [
        "guardrail.check"
      ]
    },
    "harness": {
      "guardrailPolicyRef": "gr://policies/baseline-v1"
    },
    "health": {
      "liveness": "/healthz",
      "readiness": "/readyz",
      "startupTimeoutSec": 60
    },
    "state": {
      "stateless": false,
      "store": "sql",
      "stateSchemaVersion": 1
    },
    "drivers": {
      "supported": [
        "local",
        "compose"
      ]
    },
    "compat": {
      "agentCore": ">=0.1 <1.0",
      "a2a": "1.0"
    },
    "secrets": [
      {
        "name": "guard-secret",
        "required": true
      }
    ]
  }
}
