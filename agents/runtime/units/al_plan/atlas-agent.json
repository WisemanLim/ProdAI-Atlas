{
  "apiVersion": "agents.prodai.io/v1alpha1",
  "kind": "AtlasAgent",
  "metadata": {
    "name": "al-plan",
    "unitId": "AL-PLAN",
    "layer": "L1",
    "concept": "01-agentic-loops",
    "labels": {"atlas.prodai.io/owner": "team-runtime"}
  },
  "spec": {
    "version": "0.1.0",
    "artifacts": {"wheel": "prodai-agent-al-plan==0.1.0"},
    "agentCard": {"path": "/.well-known/agent-card.json", "signed": false, "skills": ["loop.plan", "plan.revise"]},
    "interfaces": [{"binding": "JSONRPC", "port": 8000, "path": "/a2a"}],
    "harness": {"modelAlias": "planner-default", "tools": [], "guardrailPolicyRef": null},
    "config": {"maxSteps": 12, "planFormat": "json"},
    "health": {"liveness": "/healthz", "readiness": "/readyz", "startupTimeoutSec": 60},
    "state": {"stateless": false, "store": "sql", "stateSchemaVersion": 1},
    "drivers": {"serverlessEligible": false, "supported": ["local", "compose"]},
    "compat": {"agentCore": ">=0.1 <1.0", "a2a": "1.0"}
  }
}
