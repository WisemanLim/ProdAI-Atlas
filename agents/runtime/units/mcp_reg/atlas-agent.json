{
  "apiVersion": "agents.prodai.io/v1alpha1",
  "kind": "AtlasAgent",
  "metadata": {
    "name": "mcp-reg",
    "unitId": "MCP-REG",
    "layer": "L1",
    "concept": "02-mcp"
  },
  "spec": {
    "version": "0.1.0",
    "interfaces": [
      {
        "binding": "JSONRPC",
        "port": 8000,
        "path": "/a2a"
      }
    ],
    "agentCard": {
      "path": "/.well-known/agent-card.json",
      "signed": false,
      "skills": [
        "mcp.registry"
      ]
    },
    "health": {
      "liveness": "/healthz",
      "readiness": "/readyz",
      "startupTimeoutSec": 60
    },
    "state": {
      "stateless": false,
      "store": "sql",
      "stateSchemaVersion": 1
    },
    "drivers": {
      "supported": [
        "local",
        "compose"
      ]
    },
    "compat": {
      "agentCore": ">=0.1 <1.0",
      "a2a": "1.0"
    },
    "secrets": [
      {
        "name": "mcp-oauth-client-secret",
        "required": false
      }
    ]
  }
}