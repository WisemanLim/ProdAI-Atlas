# atlas-agent-runtime — local 모드 (docker compose · SQLite). 시크릿 없음 → 커밋 가능 / no secrets, committable
APP_ENV=local
BIND_HOST=127.0.0.1
API_PORT=8000
DB_ENGINE=sqlite
DATABASE_URL=sqlite:////app/data/app.db
# Atlas Agent Spec (PRD §11.13) — 루트 compose 는 environment 로 덮어씀
ATLAS_UNIT_MODULE=units.al_plan
ATLAS_PUBLIC_URL=http://127.0.0.1:8000
ATLAS_MANAGER_URL=
ATLAS_PROJECT=default
ATLAS_DEPLOY_ENV=dev
ATLAS_DRIVER=compose
ATLAS_AUTO_MIGRATE=true
