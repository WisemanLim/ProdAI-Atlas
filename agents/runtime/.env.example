# .env.prod 템플릿 (커밋용) — cp .env.example .env.prod 후 CHANGE_ME 교체
APP_ENV=prod
BIND_HOST=127.0.0.1
API_PORT=8000
DB_ENGINE=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@db:5432/app
# Atlas Agent Spec (PRD §11.13) — 루트 compose 는 environment 로 덮어씀
ATLAS_UNIT_MODULE=units.al_plan
ATLAS_PUBLIC_URL=http://127.0.0.1:8000
ATLAS_MANAGER_URL=
ATLAS_PROJECT=default
ATLAS_DEPLOY_ENV=dev
ATLAS_DRIVER=compose
ATLAS_AUTO_MIGRATE=true
