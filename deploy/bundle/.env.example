# prodai-atlas — 환경 변수 예시 (커밋). cp .env.example .env.prod 후 CHANGE_ME 교체.
ATLAS_VERSION=0.2.0
# Manager 리슨 주소 (데스크톱 사이드카는 127.0.0.1:<임의 포트>)
ATLAS_LISTEN=:8080
APP_ENV=prod
BIND_HOST=127.0.0.1
MANAGER_PORT=8080
AL_PLAN_PORT=8000
AL_RUN_PORT=8001
MCP_REG_PORT=8002
MCP_DEMO_PORT=8003
MCP_TOOL_PORT=8004
ATLAS_MCP_REG_ADMIN_TOKEN=CHANGE_ME
GR_PORT=8005
ATLAS_GUARD_ADMIN_TOKEN=CHANGE_ME
ATLAS_GUARD_SECRET=CHANGE_ME
ATLAS_GUARD_ON_ERROR=fail_open
# Gateway 배치 폴링 첫 간격(초) — local 은 시험용 1초
ATLAS_BATCH_POLL_BASE_SEC=60
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_USER=atlas
CLICKHOUSE_PASSWORD=CHANGE_ME
OB_PORT=8006
ATLAS_OB_CAPTURE=redacted
ATLAS_OB_ECHO_RECEIVER=false
ATLAS_OB_ALERT_INTERVAL=30
EV_PORT=8007
ATLAS_EV_CURATOR_TOKEN=CHANGE_ME
GATEWAY_PORT=8090
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
ATLAS_PROBE_INTERVAL=5s
# AI Gateway — 관리 토큰·부트스트랩 가상키(sk-atlas-prod-<22 base62>)·업스트림 키는 Secret 으로 주입
ATLAS_GATEWAY_ADMIN_TOKEN=CHANGE_ME
ATLAS_GATEWAY_AL_PLAN_KEY=CHANGE_ME
OPENAI_BASE_URL=
OPENAI_API_KEYS=CHANGE_ME
CONSOLE_PORT=5173
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
DB_ENGINE=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=atlas
DB_USER=atlas
DB_PASSWORD=CHANGE_ME
MANAGER_DATABASE_URL=postgresql://atlas:CHANGE_ME@db:5432/atlas
RUNTIME_DATABASE_URL=postgresql+psycopg://atlas:CHANGE_ME@db:5432/atlas

# ---- 인증·인가·테넌시 (PLT-IAM · PLT-TEN, M2) ----
# Manager 인증 모드: off = 로컬 개발(모두 관리자, 인증 없음) · oidc = Keycloak 토큰 또는 API 키 필수
ATLAS_AUTH_MODE=oidc
KEYCLOAK_PORT=8180
# 브라우저가 여는 Keycloak 주소 = 토큰 issuer (원격 설치는 공개 주소로)
ATLAS_KEYCLOAK_URL=http://127.0.0.1:8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
# realm atlas 의 서비스 계정 클라이언트(atlas-ci) 비밀 — client credentials (FR-PLT-IAM-06)
ATLAS_KC_CI_SECRET=CHANGE_ME
OPENFGA_PRESHARED_KEY=CHANGE_ME
# A2A 테넌트 JWT 서명 키 (EC P-256 PEM 또는 base64(PEM)). 비우면 임시 키(단일 인스턴스만)
ATLAS_A2A_SIGNING_KEY=CHANGE_ME
# 에이전트 자가 등록·MCP 도구용 서비스 API 키 (atl_{env}_{26자}_{secret})
ATLAS_MANAGER_BOOTSTRAP_KEY=CHANGE_ME
# 에이전트 A2A 테넌트 토큰 검사: off · verify(있으면 검증) · required
ATLAS_A2A_AUTH=verify

# ---- 비밀 (PLT-SEC, M2) ----
# Manager 비밀 저장소: file:///경로 (로컬) · bao://호스트:포트/마운트?token_file=… (OpenBao KV v2)
ATLAS_SECRET_STORE=bao://openbao:8200/atlas?token_file=/run/secrets/atlas/bao/manager
# Gateway 공급자 키 저장소 (비우면 OPENAI_API_KEYS env — 키 회전 API 비활성)
ATLAS_GATEWAY_SECRET_STORE=bao://openbao:8200/atlas?token_file=/run/secrets/atlas/bao/gateway
# 에이전트 환경변수 비밀 허용 (기본 false — Manager 비밀 중개만)
ATLAS_ALLOW_ENV_SECRETS=false

# 이미지 레지스트리 (에어갭: 사설 레지스트리 주소)
ATLAS_REGISTRY=ghcr.io/prodai
