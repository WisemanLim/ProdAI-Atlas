{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProdAI Atlas",
  "version": "0.2.0",
  "identifier": "io.prodai.atlas",
  "build": { "frontendDist": "../ui" },
  "app": {
    "windows": [
      { "label": "main", "title": "ProdAI Atlas", "url": "index.html", "width": 1360, "height": 860, "minWidth": 960, "minHeight": 600 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/atlas-manager"],
    "category": "DeveloperTool",
    "license": "Apache-2.0",
    "copyright": "ProdAI Atlas contributors",
    "macOS": { "minimumSystemVersion": "11.0", "signingIdentity": "-" }
  }
}
